# Base URL of the Zaibaraish backend API (including the /api prefix).
# Local dev default — change to your deployed backend URL for staging/production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public canonical site URL, used for SEO/meta tags (e.g. og:url, canonical link).
NEXT_PUBLIC_SITE_URL=https://zaibaraish.pk

# Optional: Stripe publishable key. Leave blank to disable card checkout via Stripe
# (Cash on Delivery / Safepay remain the primary Pakistan payment flows).
NEXT_PUBLIC_STRIPE_KEY=

# Optional: Google OAuth client ID. Leave blank to disable "Sign in with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
